      "post": {
        "tags": [
          "query-suggestions"
        ],
        "summary": "Create a configuration",
        "description": "Creates a new Query Suggestions configuration.\n\nYou can have up to 100 configurations per Algolia application.\n",
        "operationId": "CreateConfig",
        "requestBody": {
          "content": {
