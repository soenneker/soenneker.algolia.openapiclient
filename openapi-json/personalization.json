          "name": "EventType",
          "modelAsString": false,
          "values": [
            {
              "value": "click",
              "name": "Click"
            },
            {
              "value": "conversion",
              "name": "Conversion"
            },
            {
              "value": "view",
              "name": "View"
            }
          ]
