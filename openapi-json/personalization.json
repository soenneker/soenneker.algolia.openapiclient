        "type": "object"
      },
      "CustomPostRequestRequestBody": {
        "type": "object"
      },
      "CustomPost200ResponseSchema": {
        "type": "object"
      },
      "CustomPutRequestRequestBody": {
        "type": "object"
      },
      "CustomPut200ResponseSchema": {
        "type": "object"
      },
      "CustomDelete200ResponseSchema": {
        "type": "object"
      },
      "GetUserTokenResponseScores": {
        "type": "object",
        "description": "Scores for different facet values.\n\nScores represent the user affinity for a user profile towards specific facet values,\ngiven the personalization strategy and past events.\n"
      }
    },
